// Cherri 2.3.0 fileRequest incorrectly requires a dictionary body.
const created = rawAction("is.workflow.actions.downloadurl", {
    "WFURL": "{@createURL}",
    "WFHTTPMethod": "POST",
    "WFHTTPBodyType": "File",
    "WFRequestVariable": "${@inputFile}",
    "WFHTTPHeaders": {
        "CF-Access-Client-Id": "{clientID}",
        "CF-Access-Client-Secret": "{clientSecret}",
        "Upload-Filename": "{uploadFilename}"
    }
})
const creation = getDictionary(created)
const jobID = getValue(creation, "id")
const creationState = getValue(creation, "state")
const validID = matchText('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$', "{jobID}")
if !validID || creationState.text != "awaiting_review" {
    alert("The media could not be prepared for review. Check the file and try again.")
    stop()
}
// Never use response-supplied URLs as credential-bearing request destinations.
@statusURL = "{baseURL}/v1/{@resource}/{jobID}"
@contentURL = "{@statusURL}/content"
const returnedStatus = getValue(creation, "status_url")
if returnedStatus.text != @statusURL {
    alert("Unexpected status URL. Check the server public base URL.")
    stop()
}
@estimateURL = "{baseURL}/v1/jobs/{jobID}/estimate"
@startURL = "{baseURL}/v1/jobs/{jobID}/start"
const estimateRaw = rawAction("is.workflow.actions.downloadurl", {
    "WFURL": "{@estimateURL}",
    "WFHTTPMethod": "POST",
    "WFHTTPBodyType": "JSON",
    "WFJSONValues": {},
    "WFHTTPHeaders": {
        "CF-Access-Client-Id": "{clientID}",
        "CF-Access-Client-Secret": "{clientSecret}",
        "Accept": "application/json"
    }
})
@estimate = getDictionary(estimateRaw)
const sizeMin = getValue(@estimate, "size_min_bytes")
const sizeMax = getValue(@estimate, "size_max_bytes")
const etaMin = getValue(@estimate, "eta_min_seconds")
const etaMax = getValue(@estimate, "eta_max_seconds")
const method = getValue(@estimate, "method")
const confidence = getValue(@estimate, "confidence")
const estimateSourceRaw = getValue(@estimate, "source")
const estimateSource = getDictionary(estimateSourceRaw)
const sourceBytes = getValue(estimateSource, "bytes")
const reductionMinValue = (sourceBytes.number - sizeMax.number) / sourceBytes.number * 100
const reductionMaxValue = (sourceBytes.number - sizeMin.number) / sourceBytes.number * 100
const reductionMin = formatNumber(reductionMinValue, 0)
const reductionMax = formatNumber(reductionMaxValue, 0)
@decision = ""
menu "Estimate: {sizeMin}–{sizeMax} bytes · change {reductionMin}% to {reductionMax}% (positive means smaller) · {etaMin}–{etaMax} sec · {confidence} confidence · {method}. Start, refine, or discard?" {
    item "Start":
        @decision = "start"
    item "Refine estimate":
        @decision = "refine"
    item "Discard":
        @decision = "discard"
}
if @decision == "refine" {
    const refinedRaw = downloadURL(@estimateURL, {"CF-Access-Client-Id": "{clientID}", "CF-Access-Client-Secret": "{clientSecret}"})
    @estimate = getDictionary(refinedRaw)
    const refinedSizeMin = getValue(@estimate, "size_min_bytes")
    const refinedSizeMax = getValue(@estimate, "size_max_bytes")
    const refinedEtaMin = getValue(@estimate, "eta_min_seconds")
    const refinedEtaMax = getValue(@estimate, "eta_max_seconds")
    const refinedConfidence = getValue(@estimate, "confidence")
    const refinedSourceRaw = getValue(@estimate, "source")
    const refinedSource = getDictionary(refinedSourceRaw)
    const refinedSourceBytes = getValue(refinedSource, "bytes")
    const refinedReductionMinValue = (refinedSourceBytes.number - refinedSizeMax.number) / refinedSourceBytes.number * 100
    const refinedReductionMaxValue = (refinedSourceBytes.number - refinedSizeMin.number) / refinedSourceBytes.number * 100
    const refinedReductionMin = formatNumber(refinedReductionMinValue, 0)
    const refinedReductionMax = formatNumber(refinedReductionMaxValue, 0)
    menu "Refined estimate: {refinedSizeMin}–{refinedSizeMax} bytes · change {refinedReductionMin}% to {refinedReductionMax}% (positive means smaller) · {refinedEtaMin}–{refinedEtaMax} sec · {refinedConfidence} confidence. Start or discard?" {
        item "Start":
            @decision = "start"
        item "Discard":
            @decision = "discard"
    }
}
if @decision == "discard" {
    rawAction("is.workflow.actions.downloadurl", {
        "WFURL": "{@statusURL}",
        "WFHTTPMethod": "DELETE",
        "WFHTTPHeaders": {
            "CF-Access-Client-Id": "{clientID}",
            "CF-Access-Client-Secret": "{clientSecret}"
        }
    })
    stop()
}
const startedRaw = rawAction("is.workflow.actions.downloadurl", {
    "WFURL": "{@startURL}",
    "WFHTTPMethod": "POST",
    "WFHTTPBodyType": "JSON",
    "WFJSONValues": {},
    "WFHTTPHeaders": {
        "CF-Access-Client-Id": "{clientID}",
        "CF-Access-Client-Secret": "{clientSecret}",
        "Accept": "application/json"
    }
})
@response = getDictionary(startedRaw)
const startedID = getValue(@response, "id")
const startedURL = getValue(@response, "status_url")
const startedState = getValue(@response, "state")
if startedID.text != jobID.text || startedURL.text != @statusURL || startedState.text != "queued" {
    alert("The job could not be started safely. Check the server response.")
    stop()
}
@ready = false
repeat poll for 200 {
    if @ready == false {
        if @poll > 1 {
            wait(3)
        }
        const status = downloadURL(@statusURL, {"CF-Access-Client-Id": "{clientID}", "CF-Access-Client-Secret": "{clientSecret}"})
        @response = getDictionary(status)
        const responseID = getValue(@response, "id")
        const responseURL = getValue(@response, "status_url")
        const state = getValue(@response, "state")
        if responseID.text != jobID.text || responseURL.text != @statusURL {
            alert("Malformed job identity or status URL.")
            stop()
        }
        if state.text == "ready" {
            @ready = true
        } else {
            if state.text == "failed" {
                const errorRaw = getValue(@response, "error")
                const errorData = getDictionary(errorRaw)
                const errorMessage = getValue(errorData, "message")
                alert("Job failed: {errorMessage}")
                stop()
            } else {
                if state.text != "queued" && state.text != "processing" {
                    alert("Unknown or missing job state.")
                    stop()
                }
            }
        }
    }
}
if @ready == false {
    alert("Conversion timed out. Please try again.", "Media Manager")
    stop()
}
const inputRaw = getValue(@response, "input")
const outputRaw = getValue(@response, "output")
const inputData = getDictionary(inputRaw)
const outputData = getDictionary(outputRaw)
const inputBytes = getValue(inputData, "bytes")
const outputBytes = getValue(outputData, "bytes")
const outputName = getValue(outputData, "filename")
const returnedDownload = getValue(outputData, "download_url")
@outputFileName = "{outputName}"
const validInputBytes = matchText('^[1-9][0-9]*$', "{inputBytes}")
const validOutputBytes = matchText('^[1-9][0-9]*$', "{outputBytes}")
if !validInputBytes || !validOutputBytes || !@outputFileName || @outputFileName contains "/" || @outputFileName contains "\\" {
    alert("Missing or invalid result sizes or filename.")
    stop()
}
if returnedDownload.text != @contentURL {
    alert("Unexpected download URL.")
    stop()
}
@notice = ""
if @compress == true {
    const compressionRaw = getValue(@response, "compression")
    const compressionData = getDictionary(compressionRaw)
    const targetBytes = getValue(compressionData, "target_bytes")
    const metTarget = getValue(compressionData, "met_target")
    const attempts = getValue(compressionData, "attempts")
    const validAttempts = matchText('^[1-5]$', "{attempts}")
    if targetBytes.text != "20000000" || !validAttempts {
        alert("Invalid compression threshold or attempt count.")
        stop()
    }
    if outputBytes.number < 20000000 {
        if metTarget.number != 1 {
            alert("Compression success flag disagrees with the byte count.")
            stop()
        }
        @notice = "Below 20 MB."
    } else {
        if metTarget.number == 1 {
            alert("Compression success flag disagrees with the byte count.")
            stop()
        }
        @notice = "Could not produce a valid result below 20 MB. This is the smallest valid candidate."
    }
}
const inputByteNumber = number(inputBytes)
const outputByteNumber = number(outputBytes)
const difference = inputByteNumber - outputByteNumber
const inputMegabytes = inputByteNumber / 1000000
const outputMegabytes = outputByteNumber / 1000000
const differenceMegabytes = difference / 1000000
const differenceFraction = difference / inputByteNumber
const differencePercentValue = differenceFraction * 100
const inputSize = formatNumber(inputMegabytes, 2)
const outputSize = formatNumber(outputMegabytes, 2)
const differenceSize = formatNumber(differenceMegabytes, 2)
const differencePercent = formatNumber(differencePercentValue, 1)
@keep = false
menu "Input: {inputSize} MB\nOutput: {outputSize} MB\nChange: {differenceSize} MB ({differencePercent}%; positive means smaller)\n{@notice}\nKeep this result?" {
    item "Keep":
        @keep = true
    item "Discard":
        @keep = false
}
if @keep == false {
    rawAction("is.workflow.actions.downloadurl", {
        "WFURL": "{@statusURL}",
        "WFHTTPMethod": "DELETE",
        "WFHTTPHeaders": {
            "CF-Access-Client-Id": "{clientID}",
            "CF-Access-Client-Secret": "{clientSecret}"
        }
    })
    stop()
}
wait(1)
const downloaded = downloadURL(@contentURL, {"CF-Access-Client-Id": "{clientID}", "CF-Access-Client-Secret": "{clientSecret}"})
const namedOutput = setName(downloaded, "{@outputFileName}")
share(namedOutput)
