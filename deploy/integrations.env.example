# Use exact verified JWT principal IDs; service tokens stay on the devices.
MEDIA_MANAGER_PRINCIPAL_OWNERS={"service:replace-with-verified-service-id":"user:replace-with-browser-owner"}
MEDIA_MANAGER_TELEGRAM_BOT_TOKEN=
MEDIA_MANAGER_TELEGRAM_CHAT_ID=
MEDIA_MANAGER_TELEGRAM_USER_ID=
MEDIA_MANAGER_TELEGRAM_OWNER_ID=
