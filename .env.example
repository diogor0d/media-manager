# Build the production image from a clean source commit and use that commit as the tag.
MEDIA_MANAGER_IMAGE=media-manager:replace-with-git-commit
MEDIA_MANAGER_SOURCE_REVISION=replace-with-git-commit

# The host-managed cloudflared connector will target this loopback listener.
MEDIA_MANAGER_PORT=18081
MEDIA_MANAGER_PUBLIC_BASE_URL=https://media.example.com

# Non-secret Cloudflare Access application metadata. Never put service-token
# client IDs or secrets here; those belong only on each authorized iOS device.
MEDIA_MANAGER_CF_ISSUER=https://example.cloudflareaccess.com
MEDIA_MANAGER_CF_AUDIENCE=replace-with-access-application-aud
